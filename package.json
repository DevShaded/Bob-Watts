{
  "name": "bob-watts",
  "version": "3.0.0",
  "description": "A multi purpose bot including fun and epic commands",
  "main": "index.js",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "start": "node index.js",
    "run": "node index.js",
    "dev": "node --watch index.js",
    "db:up": "docker compose up -d --wait mysql",
    "db:down": "docker compose down",
    "db:generate": "prisma generate",
    "db:setup": "prisma migrate deploy && prisma generate",
    "check": "prisma validate && node scripts/check-setup.js",
    "migrate": "prisma migrate dev --name migration && prisma generate",
    "register": "node createapplicationcommands.js",
    "test": "node --test",
    "postinstall": "prisma generate"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DevShaded/Bob-Watts.git"
  },
  "author": "DevShaded",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/DevShaded/Bob-Watts/issues"
  },
  "homepage": "https://github.com/DevShaded/Bob-Watts#readme",
  "dependencies": {
    "@prisma/client": "7.10.0",
    "axios": "^1.20.0",
    "discord.js": "^14.27.0",
    "dotenv": "^18.0.7",
    "moment": "^2.31.0",
    "ms": "^2.1.3",
    "@prisma/adapter-mariadb": "7.10.0"
  },
  "devDependencies": {
    "pm2": "^7.0.4",
    "prisma": "7.10.0"
  },
  "overrides": {
    "@prisma/adapter-mariadb": {
      "mariadb": "^3.5.4"
    },
    "@prisma/config": {
      "deepmerge-ts": "^8.0.2"
    },
    "prisma": {
      "mysql2": "^3.24.6"
    },
    "pm2": {
      "basic-ftp": "^6.2.3",
      "js-yaml": "^4.3.2"
    }
  }
}
