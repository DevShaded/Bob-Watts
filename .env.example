# This was inserted by `prisma init`:
# Environment variables declared in this file are automatically made available to Prisma.
# See the documentation for more detail: https://pris.ly/d/prisma-schema#accessing-environment-variables-from-the-schema

# Prisma supports the native connection string format for PostgreSQL, MySQL, SQLite, SQL Server, MongoDB (Preview) and CockroachDB (Preview).
# See the documentation for all the connection string options: https://pris.ly/d/connection-strings

# Local Docker database only. Use separate credentials for hosted databases.
MYSQL_ROOT_PASSWORD=bobwatts-local
MYSQL_PORT=3307
DATABASE_URL="mysql://root:bobwatts-local@127.0.0.1:3307/bobwattsv3"

# This is not inserted by `prisma init`
APP_NAME="Bob Watts"
APP_ENV=development
APP_TOKEN=
APP_DEBUG=false

# Discord application ID, test server ID, and a text channel in that server
APP_CLIENT_ID=
APP_GUILD_ID=
APP_CHANNEL_ID=

# Optional: only needed for /weather (https://openweathermap.org/)
APP_WEATHER_API=
